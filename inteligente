',0xdfe3e6,0.25,0.1);\nconst g=new THREE.Group(); g.name='SAN-111';\n// Ficha técnica: 26,5 x 15,1 x 17,3 in\nconst L=0.673, W=0.384, H=0.439, N=160, HB=0.392, ZC=-0.155, G=0.003;\nfunction outline(t,a=W/2,b=L/2){const c=Math.cos(t),s=Math.sin(t),n=s>0?2.4:5;\n return [a*Math.sign(c)*Math.pow(Math.abs(c),2/n), b*Math.sign(s)*Math.pow(Math.abs(s),2/n)];}\nconst ring=(a,b,dz=0)=>{const p=[];for(let i=0;i<N;i++){const [x,z]=outline(i/N*Math.PI*2,a,b);p.push([x,z+dz])}return p};\nconst ell=(a,b,cz,n=N)=>{const p=[];for(let i=0;i<n;i++){const t=i/n*Math.PI*2;p.push([a*Math.cos(t),cz+b*Math.sin(t)])}return p};\nconst mk=(name,geo,mat,parent=g)=>{const m=new THREE.Mesh(geo,mat);m.name=name;m.castShadow=m.receiveShadow=true;parent.add(m);return m};\nconst loftGeo=(levels,capBottom)=>{const pos=[],idx=[];levels.forEach(l=>l.r.forEach(p=>pos.push(p[0],l.y,p[1])));\n for(let j=0;j<levels.length-1;j++)for(let i=0;i<N;i++){const a=j*N+i,b=j*N+(i+1)%N;idx.push(a,a+N,b,b,a+N,b+N)}\n if(capBottom){const c=pos.length/3,l=levels[levels.length-1];pos.push(0,l.y,capBottom);for(let i=0;i<N;i++)idx.push(c,(levels.length-1)*N+i,(levels.length-1)*N+(i+1)%N)}\n const bg=new THREE.BufferGeometry();bg.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));bg.setIndex(idx);bg.computeVertexNormals();return bg};\n// cuerpo cerámico (loft troncocónico)\nconst levels=[];const LV=28;\nfor(let j=0;j<=LV;j++){const s=j/LV,e=1-Math.pow(1-s,1.6);\n let len=L*0.775+(L-L*0.775)*e,wid=W*0.84+(W-W*0.84)*e,dz=-0.008*(1-e);\n if(j===0){len-=0.03;wid-=0.03} if(j===LV){len-=0.008;wid-=0.008}\n levels.push({y:s*HB,r:ring(wid/2,len/2,dz)});}\nlevels.splice(1,0,{y:0.012,r:ring(W*0.42,L*0.3875,-0.008)});\n// hueco trasero de servicio (sifón, válvula, manguera, cableado)\nconst AY=0.285, ZN=-0.175, XN=0.118;\nlet NI=null;const notch=r=>r.map(([x,z],i)=>NI.has(i)?[Math.max(-XN,Math.min(XN,x)),Math.max(z,ZN)]:[x,z]);\n{const j=levels.findIndex(l=>l.y>AY),l0=levels[j-1],l1=levels[j],t=(AY-l0.y)/(l1.y-l0.y);\